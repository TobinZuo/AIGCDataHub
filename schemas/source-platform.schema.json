{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigcdatahub.example/schemas/source-platform.schema.json",
  "title": "AIGCDataHub candidate content-source platform registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "platforms"],
  "properties": {
    "schema_version": {"const": 2},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "rights", "internal_notes"],
      "properties": {
        "boundary": {"type": "string", "minLength": 20},
        "rights": {"type": "string", "minLength": 20},
        "internal_notes": {"type": "string", "minLength": 20}
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "homepage", "category", "modalities",
          "relevant_scenarios", "content_scope", "data_access", "monitoring",
          "source_status", "access_boundary", "rights_review", "last_reviewed"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 2},
          "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
          "category": {"enum": ["video-platform", "streaming-and-studio", "stock-media", "ecommerce"]},
          "modalities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["image", "video", "audio", "text"]}
          },
          "relevant_scenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["image-generation", "video-generation", "digital-human", "video-localization", "virtual-try-on"]}
          },
          "content_scope": {"type": "string", "minLength": 20},
          "data_access": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status", "interface_name", "interface_url", "scope",
              "requirements", "training_rights"
            ],
            "properties": {
              "status": {
                "enum": [
                  "documented-api", "partner-api", "partner-portal",
                  "licensed-service", "not-cataloged"
                ]
              },
              "interface_name": {"type": ["string", "null"], "minLength": 2},
              "interface_url": {
                "anyOf": [
                  {"type": "string", "format": "uri", "pattern": "^https://"},
                  {"type": "null"}
                ]
              },
              "scope": {"type": "string", "minLength": 20},
              "requirements": {"type": "string", "minLength": 10},
              "training_rights": {"const": "not-granted-by-interface"}
            }
          },
          "monitoring": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "mode", "focus", "priority"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "mode": {"enum": ["content-revision", "availability"]},
              "focus": {"type": "string", "minLength": 10},
              "priority": {"enum": ["high", "standard"]}
            }
          },
          "source_status": {"const": "candidate"},
          "access_boundary": {"const": "source-platform-not-dataset"},
          "rights_review": {"const": "required"},
          "last_reviewed": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
