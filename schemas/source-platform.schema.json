{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigcdatahub.example/schemas/source-platform.schema.json",
  "title": "AIGCDataHub candidate content-source platform registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "platforms"],
  "properties": {
    "schema_version": {"const": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "rights", "internal_notes"],
      "properties": {
        "boundary": {"type": "string", "minLength": 20},
        "rights": {"type": "string", "minLength": 20},
        "internal_notes": {"type": "string", "minLength": 20}
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "homepage", "category", "modalities",
          "relevant_scenarios", "content_scope", "source_status",
          "access_boundary", "rights_review", "last_reviewed"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 2},
          "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
          "category": {"enum": ["video-platform", "streaming-and-studio", "stock-media", "ecommerce"]},
          "modalities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["image", "video", "audio", "text"]}
          },
          "relevant_scenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["image-generation", "video-generation", "digital-human", "video-localization", "virtual-try-on"]}
          },
          "content_scope": {"type": "string", "minLength": 20},
          "source_status": {"const": "candidate"},
          "access_boundary": {"const": "source-platform-not-dataset"},
          "rights_review": {"const": "required"},
          "last_reviewed": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
