{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigcdatahub.example/schemas/dataset.schema.json",
  "title": "AIGCDataHub dataset card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "organization",
    "released_at",
    "release_date_source",
    "modality",
    "tasks",
    "stages",
    "description",
    "access",
    "scale",
    "annotations",
    "license",
    "quality",
    "processing",
    "evidence",
    "status",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 2},
    "organization": {"type": "string", "minLength": 2},
    "released_at": {"type": "string", "format": "date"},
    "release_date_source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "modality": {
      "enum": ["image", "video", "audio", "3d", "preference", "evaluation"]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["pretraining", "fine-tuning", "preference-tuning", "evaluation", "data-curation"]
      }
    },
    "description": {"type": "string", "minLength": 20},
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_id", "relationship", "contribution", "notes"],
        "properties": {
          "catalog_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "relationship": {
            "enum": [
              "source-component",
              "filtered-subset",
              "annotation-derivative",
              "benchmark-derivative",
              "transformed-derivative"
            ]
          },
          "contribution": {"type": "string", "minLength": 3},
          "notes": {"type": "string", "minLength": 10}
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "type", "url", "requires_account", "notes"],
      "properties": {
        "status": {"enum": ["open", "gated", "metadata-only", "unavailable"]},
        "type": {"enum": ["hosted", "urls", "metadata", "request", "none"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "requires_account": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 5}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "approximate", "notes"],
      "properties": {
        "samples": {"type": ["integer", "null"], "minimum": 1},
        "source_items": {"type": ["integer", "null"], "minimum": 1},
        "hours": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "approximate": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 3}
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "source", "languages"],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "source": {"enum": ["human", "model-generated", "web-metadata", "mixed", "unknown"]},
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "media", "commercial_use", "redistribution", "notes"],
      "properties": {
        "metadata": {"type": "string"},
        "media": {"type": "string"},
        "commercial_use": {"enum": ["allowed", "noncommercial", "review-required", "unknown"]},
        "redistribution": {"enum": ["allowed", "prohibited", "review-required", "unknown"]},
        "notes": {"type": "string", "minLength": 10}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "known_limitations"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "visual-quality",
              "audio-quality",
              "audio-visual-alignment",
              "text-media-alignment",
              "aesthetics",
              "motion",
              "temporal-consistency",
              "geometry-quality",
              "multi-view-consistency",
              "watermark",
              "safety",
              "deduplication",
              "human-preference",
              "provenance"
            ]
          }
        },
        "known_limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 5}
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "recommended_format", "notes"],
      "properties": {
        "recipe": {"type": ["string", "null"]},
        "recommended_format": {"enum": ["webdataset", "parquet", "lance", "native", "csv"]},
        "notes": {"type": "string", "minLength": 5}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "paper", "used_by"],
      "properties": {
        "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
        "paper": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "pattern": "^https://"}
          ]
        },
        "used_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["verified", "partial", "archived"]},
    "last_verified": {"type": "string", "format": "date"}
  }
}
