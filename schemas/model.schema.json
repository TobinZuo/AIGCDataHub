{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigcdatahub.example/schemas/model.schema.json",
  "title": "AIGCDataHub model and data-strategy card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "organization",
    "released_at",
    "modalities",
    "tasks",
    "access",
    "architecture",
    "data",
    "evidence",
    "status",
    "last_verified"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "organization": {"type": "string", "minLength": 2},
    "released_at": {"type": "string", "format": "date"},
    "ranking_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["image", "video", "audio", "3d", "action", "multimodal"]}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "license", "release_url", "weights_url", "api_url"],
      "properties": {
        "status": {
          "enum": ["open-weights", "gated-weights", "api-only", "product-only", "early-access", "research-preview", "announced"]
        },
        "license": {"type": "string", "minLength": 2},
        "release_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "weights_url": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "pattern": "^https://"}
          ]
        },
        "api_url": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "pattern": "^https://"}
          ]
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "parameters", "notes"],
      "properties": {
        "family": {"type": "string", "minLength": 2},
        "parameters": {"type": ["integer", "null"], "minimum": 1},
        "notes": {"type": "string", "minLength": 10}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_level",
        "exact_datasets_disclosed",
        "exact_mixture_disclosed",
        "datasets",
        "stages",
        "strategy_summary",
        "unknowns"
      ],
      "properties": {
        "disclosure_level": {"enum": ["full", "partial", "high-level", "undisclosed"]},
        "exact_datasets_disclosed": {"type": "boolean"},
        "exact_mixture_disclosed": {"type": "boolean"},
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "catalog_id", "role", "availability", "scale", "notes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "catalog_id": {
                "anyOf": [
                  {"type": "null"},
                  {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
                ]
              },
              "role": {"enum": ["pretraining", "fine-tuning", "preference", "evaluation", "distillation"]},
              "availability": {"enum": ["public", "gated", "not-released", "undisclosed"]},
              "scale": {"type": ["string", "null"]},
              "notes": {"type": "string", "minLength": 5}
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "modalities", "source_types", "operations", "scale_disclosed", "strategy"],
            "properties": {
              "name": {"enum": ["pretraining", "midtraining", "fine-tuning", "preference", "distillation", "action-adaptation"]},
              "modalities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["image", "video", "audio", "text", "action", "3d", "unknown"]}
              },
              "source_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "public-web",
                    "public-dataset",
                    "licensed",
                    "proprietary",
                    "synthetic",
                    "human-feedback",
                    "robot-demonstration",
                    "undisclosed"
                  ]
                }
              },
              "operations": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
              },
              "scale_disclosed": {"type": "boolean"},
              "strategy": {"type": "string", "minLength": 15}
            }
          }
        },
        "strategy_summary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        },
        "unknowns": {
          "type": "array",
          "items": {"type": "string", "minLength": 5}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "technical_report", "repository"],
      "properties": {
        "release": {"type": "string", "format": "uri", "pattern": "^https://"},
        "technical_report": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "pattern": "^https://"}
          ]
        },
        "repository": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "pattern": "^https://"}
          ]
        }
      }
    },
    "status": {"enum": ["verified", "partial", "watch"]},
    "last_verified": {"type": "string", "format": "date"}
  }
}
